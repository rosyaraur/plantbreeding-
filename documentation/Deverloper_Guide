│   └── state.py                # Conversation memory and file tracking
│
├── tools/                      # The "Hands" (Bridge to Math)
│   ├── tool_registry.py        # Master manifest of all AI capabilities
│   ├── python_wrappers.py      # LangChain @tool wrappers for Python
│   └── r_wrappers.py           # rpy2 wrappers for R scripts
│
├── core_logic/                 # The "Muscle" (Standalone Packages)
